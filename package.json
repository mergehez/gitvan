{
    "name": "gitvan",
    "version": "0.1.0",
    "description": "Gitvan desktop Git client with Vue and Vite",
    "license": "MIT",
    "author": {
        "name": "Mergesoft"
    },
    "type": "module",
    "scripts": {
        "build": "bun install && vp build && electrobun build",
        "test:ui": "vitest run",
        "release:audit": "bash ./scripts/release-audit.sh",
        "release:validate": "vitest run --exclude tests/App.real.spec.ts && bun run build",
        "release:mac": "bun run ./scripts/build.ts",
        "release:mac:signed": "bun run ./scripts/build.ts --signed",
        "release:mac:notarize": "bun run ./scripts/build.ts --notarize",
        "dev2": "pkill -f electrobun 2>/dev/null && pkill -f \"bun run\" 2>/dev/null && rm -rf dist/ || true && concurrently \"vp dev --port 5173\" \"vp build && electrobun dev --watch\" --names \"Vite,Electron\" --prefix-colors \"blue,green\"",
        "dev": "concurrently -k \"node --import tsx --watch src/backend/devServer.ts\" \"sleep 2 && VITE_DEV2=true vp dev --port 5173\"",
        "build:canary": "electrobun build --env=canary",
        "build:stable": "electrobun build --env=stable",
        "lint": "oxfmt && oxlint --fix && vue-tsc --noEmit",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@guolao/vue-monaco-editor": "^1.6.0",
        "@pierre/diffs": "^1.2.12",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "better-sqlite3": "^13.0.1",
        "electrobun": "^1.18.1",
        "express": "^5.2.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@iconify/json": "^2.2.505",
        "@iconify/tailwind4": "^1.2.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/better-sqlite3": "^7.6.13",
        "@types/bun": "^1.3.14",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "@types/three": "^0.185.1",
        "@playwright/test": "^1.61.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^9.2.4",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "vue": "^3.5.40",
        "vue-tsc": "^3.3.8",
        "wait-on": "^9.1.0"
    },
    "packageManager": "bun@1.3.12",
    "productName": "Gitvan"
}
