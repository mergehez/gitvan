{
    "name": "gitvan",
    "productName": "Gitvan",
    "version": "0.1.1",
    "description": "Gitvan desktop Git client with Vue and Vite",
    "license": "MIT",
    "config": {
        "appName": "Gitvan",
        "appId": "com.mergesoft.gitvan",
        "copyright": "Copyright © MergeSoft",
        "vuePort": 5177,
        "apiPort": 5176,
        "dbFileName": "gitvan.sqlite"
    },
    "author": {
        "name": "Mergesoft"
    },
    "type": "module",
    "main": "dist-electron/main.cjs",
    "scripts": {
        "build": "bun install && vite build && bun run build:electron",
        "build:electron": "electron-builder build --config electron.config.js --arm64",
        "dev": "vite",
        "dev2": "vite --mode desktop",
        "test:ui": "vitest run",
        "release:audit": "bun do.ts audit",
        "release:validate": "vitest run --exclude tests/App.real.spec.ts && bun run build",
        "release:mac": "bun do.ts release",
        "release:mac:signed": "bun do.ts release --signed",
        "release:mac:notarize": "bun do.ts release --notarize",
        "lint": "oxfmt && oxlint --fix && vue-tsc --noEmit",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@guolao/vue-monaco-editor": "^1.6.0",
        "@pierre/diffs": "^1.5.2",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "better-sqlite3": "^13.0.3",
        "express": "^5.2.1",
        "node-pty": "^1.1.0",
        "oxlint-tsgolint": "^7.0.2003",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "electron": "^44.7.0",
        "@iconify/json": "^2.2.541",
        "@iconify/tailwind4": "^1.2.3",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/bun": "^1.4.2",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.4",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.6",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "jsdom": "^30.1.2",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.3",
        "vue": "^3.5.43",
        "vue-tsc": "3.3.11",
        "wait-on": "^9.5.1"
    },
    "packageManager": "bun@1.3.12"
}
